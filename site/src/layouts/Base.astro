---
import '../styles/global.css'
// fonts are served from this site, not Google, so visitors make no extra requests
import '@fontsource/montserrat/700.css'
import '@fontsource/montserrat/800.css'
import '@fontsource/ibm-plex-sans/400.css'
import '@fontsource/ibm-plex-sans/500.css'
import '@fontsource/ibm-plex-sans/600.css'
import '@fontsource/ibm-plex-mono/400.css'
import '@fontsource/ibm-plex-mono/500.css'
import { getImage } from 'astro:assets'
import { LANGS, type Lang } from '../i18n'
import og from '../assets/og.png'

interface Props {
  lang: Lang
  title: string
  description: string
  /** The same page in every language. */
  alternates: Record<Lang, string>
}
const { lang, title, description, alternates } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const ogImage = await getImage({ src: og, format: 'png' })
const canonical = new URL(alternates[lang], Astro.site)
const ogLocale: Record<Lang, string> = { en: 'en_US', es: 'es_ES', ru: 'ru_RU' }
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="google-site-verification" content="-7Jb3OywCA4zlS22rOus_rG1DRorboZL9pGYkpVlD5Y" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#EAF4FC" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0B1626" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(alternates[l], Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(alternates.en, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
    <meta property="og:image" content={new URL(ogImage.src, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot />
  </body>
</html>
