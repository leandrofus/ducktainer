---
import '../styles/global.css'
import { getImage } from 'astro:assets'
import { LANGS, type Lang } from '../i18n'
import og from '../assets/og.png'

interface Props {
  lang: Lang
  title: string
  description: string
  /** The same page in every language. */
  alternates: Record<Lang, string>
}
const { lang, title, description, alternates } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const ogImage = await getImage({ src: og, format: 'png' })
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="google-site-verification" content="-7Jb3OywCA4zlS22rOus_rG1DRorboZL9pGYkpVlD5Y" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#EAF4FC" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0B1626" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(alternates[l], Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(alternates.en, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage.src, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>
