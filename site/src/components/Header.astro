---
import Icon from './Icon.astro'
import { LANGS, langName, strings, type Lang } from '../i18n'
import { REPO_URL, docsPath, homePath } from '../paths'
import { Image } from 'astro:assets'
import ship from '../assets/ship.png'

interface Props {
  lang: Lang
  /** The same page in every language. */
  alternates: Record<Lang, string>
  /** Sits on the dark hero instead of the page background. */
  onHero?: boolean
  active?: 'docs'
}
const { lang, alternates, onHero = false, active } = Astro.props
const t = strings[lang]
---
<header class:list={['top', { 'on-hero': onHero }]}>
  <nav class="wrap bar" aria-label={t.nav}>
    <a class="brand" href={homePath(lang)}>
      <Image src={ship} alt="" width={46} format="webp" />
      <span>ducktainer</span>
    </a>
    <span class="grow"></span>
    <a href={docsPath(lang)} aria-current={active === 'docs' ? 'page' : undefined}>{t.docs}</a>
    <a class="hide-sm" href={`${REPO_URL}/releases`}>{t.releases}</a>
    <a href={REPO_URL} aria-label="GitHub"><Icon name="github" /></a>
    <details class="langmenu">
      <summary>
        <Icon name="globe" />
        <span class="lang-name">{langName[lang]}</span><span class="lang-code">{lang.toUpperCase()}</span>
        <span class="chev"><Icon name="chevron" /></span>
      </summary>
      <ul>
        {LANGS.map((l) => (
          <li>
            <a href={alternates[l]} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>
              {langName[l]}{l === lang && <Icon name="check" />}
            </a>
          </li>
        ))}
      </ul>
    </details>
  </nav>
</header>
<script>
  // close the language menu on a click outside it or on Escape
  const menu = document.querySelector<HTMLDetailsElement>('.langmenu')
  document.addEventListener('click', (e) => {
    if (menu?.open && !menu.contains(e.target as Node)) menu.open = false
  })
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.open) {
      menu.open = false
      menu.querySelector('summary')?.focus()
    }
  })
</script>
